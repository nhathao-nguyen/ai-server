APP_NAME=tts-server
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
DATA_DIR=./data
HF_HOME=./cache/huggingface
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_KEEP_ALIVE=0
OLLAMA_NO_CLOUD=1
# Required when HOST is a non-loopback LAN bind; keep private key ACL-restricted.
TLS_CERT_FILE=
TLS_KEY_FILE=
MAX_GPU_AI_JOBS=1
GPU_JOB_TIMEOUT_SECONDS=900
MODEL_IDLE_SLEEP_SECONDS=3600
IDLE_REAPER_INTERVAL_SECONDS=60
GPU_SWITCH_UNLOAD=true
GPU_AFFINITY_BATCH_SIZE=2
MAX_GPU_QUEUE=16
MAX_CPU_QUEUE=16
MAX_CONCURRENT_JOBS_PER_KEY=2
MAX_UPLOAD_BYTES=26214400
MAX_REFERENCE_AUDIO_SECONDS=300
JOB_RETENTION_DAYS=30
USAGE_RETENTION_DAYS=90
LOG_RETENTION_DAYS=14
DEFAULT_RATE_LIMIT_PER_MINUTE=60
DEFAULT_DAILY_QUOTA_CREDITS=100000
DEFAULT_INITIAL_CREDITS=1000000
LLM_CREDITS_PER_1K_TOKENS=1
TTS_CREDITS_PER_1K_CHARS=1
VIENEU_CPU_ONLY=true
VIENEU_MODE=v3turbo
VIENEU_DEVICE=cpu
VIENEU_BACKEND=onnx
VIENEU_PRECISION=int8
VIENEU_THREADS=0
VIENEU_MAX_BATCH_SIZE=32
